{
  "manifest_version": 3,
  "name": "VIGIL Phishing Detector",
  "version": "1.1.0",

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": ["tabs", "webNavigation", "storage"],

  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],

  "action": { "default_popup": "popup.html", "default_title": "VIGIL URL protection" },

  "background": {
    "service_worker": "background.js"
  }
}
